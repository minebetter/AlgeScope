*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.tox/
# 虚拟环境 (Virtual Environments)
venv/
env/
.venv/
.env/

# Java
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# .NET
[Bb]in/
[Oo]bj/

# Ruby
.bundle/
log/
tmp/
.byebug_history

# Go
*.exe
*.test
# 二进制文件 (通常与项目同名)
# my-go-app

# Rust
target/
Cargo.lock

# PHP / Composer
vendor/
composer.lock
composer.phar

# Elixir
deps/
_build/

# ---------------------------
# 日志、临时文件和数据库 (Logs, Temp Files & Databases)
# ---------------------------
*.log
logs/
*.log.*
*.pid
*.seed
*.pid.lock
*.sqlite
*.sqlite3
*.db

# ---------------------------
# 敏感信息 (Sensitive Information)
# ---------------------------
# 永远不要将包含密码、API密钥等敏感信息的文件提交到仓库！
# 使用 .env.example 来提供模板。
.env*
!.env.example
!.env.test
credentials.*
config.local.*
secrets.*
*.pem
*.key
private.*

# ---------------------------
# 依赖和构建产物 (Dependencies & Build Artifacts)
# ---------------------------
dist/
build/
out/
public/
coverage/
.coverage
*.zip
*.tar.*
*.gz
*.rar

# ---------------------------
# 文档生成工具 (Documentation Tools)
# ---------------------------
_site/ # Jekyll
.vuepress/dist # VuePress
.vitepress/dist # VitePress
docs/_build/ # Sphinx

# ---------------------------
# 其他工具 (Miscellaneous)
# ---------------------------
.sass-cache/
.eslintcache
.stylelintcache
.terragrunt-cache/
.terraform/
