.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
__MACOSX

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.Trash-*

# ---------------------------
# IDE 和编辑器配置 (IDE & Editor Configuration)
# ---------------------------

