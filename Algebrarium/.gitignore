.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
*.vs/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# Vim
*.swp
*.swo
*.[a-z].un~

# ---------------------------
# 语言和框架相关 (Language & Framework Specific)
# ---------------------------

# Node.js
node_modules/
npm-debug.log*
yarn-error.log
yarn.lock
package-lock.json
pnpm-lock.yaml
dist/
build/
.pnp.*

